# Copy to .env and fill in:   cp .env.example .env && nano .env
# Keep values in single quotes. Never commit .env to GitHub.

# --- Database (choose any strong values) ---
DB_PASSWORD='CHANGE_ME_db_password'
DB_ROOT_PASSWORD='CHANGE_ME_db_root_password'

# --- Web dashboard login ---
ADMIN_USER='admin'
ADMIN_PASSWORD='CHANGE_ME_admin_password'
FLASK_SECRET='put-a-long-random-string-here'

# --- Core routers (VyOS hardening user) ---
ROUTER_USER='netadmin'
ROUTER_PASS='CHANGE_ME_router_password'

# --- pfSense web admin ---
PFSENSE_HOST='10.0.0.1'
PFSENSE_USER='admin'
PFSENSE_PASS='YOUR_PFSENSE_PASSWORD'

# --- Telegram ---
TELEGRAM_TOKEN='YOUR_BOT_TOKEN'
TELEGRAM_CHAT_ID='YOUR_CHAT_ID'

# --- Email (Gmail app password, 16 letters, no spaces). Leave empty to disable email ---
SMTP_USER=''
SMTP_PASS=''
ALERT_EMAIL_TO=''

# --- Monitoring UIs (header buttons; opened through the SSH tunnel) ---
ZABBIX_URL='http://localhost:8080'
GRAFANA_URL='http://localhost:3000/d/<dashboard-uid>/smart-campus-network'

# --- Worker tuning ---
CHECK_INTERVAL='10'
FAIL_THRESHOLD='2'
ISP_INTERVAL='15'
BACKUP_INTERVAL_HOURS='24'

# --- Backups: daily time, start-up check age, how many to keep per device ---
BACKUP_DAILY_AT='02:00'
BACKUP_MAX_AGE_HOURS=24
BACKUP_KEEP=10
